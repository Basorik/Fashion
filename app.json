{
  "expo": {
    "name": "Bella",
    "slug": "bella",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bella",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.basorik.bella",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.basorik.bella",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FBF9F7",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Bella uses your photos so you can add clothing items to your wardrobe.",
          "cameraPermission": "Bella uses the camera to photograph clothing items and scan barcodes.",
          "microphonePermission": false
        }
      ],
      "expo-sqlite",
      [
        "expo-camera",
        {
          "cameraPermission": "Bella uses the camera to photograph clothing items and scan barcodes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bella uses your location to check the local weather for outfit suggestions."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#9E4636"
        }
      ],
      "./modules/bella-vision/app.plugin.js",
      "./modules/bella-share/app.plugin.js"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1c459ad9-1be1-4934-b055-ba1d16926073"
      }
    }
  }
}
